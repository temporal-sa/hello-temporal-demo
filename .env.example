# Copy to .env and fill in. .env is gitignored; this file is not.
#
# These are ENVIRONMENT VARIABLES. A .env file is a local developer
# convenience for setting them. In production the same variables are injected
# by your secret manager — there is no .env file in production.

# --- Local dev server (the default; no credentials needed) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Temporal Cloud, API key auth (TLS is enabled automatically) ---
# Use the REGIONAL endpoint with an API key, e.g. us-east-2.aws.api.temporal.io:7233
# TEMPORAL_ADDRESS=<region>.<cloud-provider>.api.temporal.io:7233
# TEMPORAL_NAMESPACE=<namespace>.<account-id>
# TEMPORAL_API_KEY=

# --- Temporal Cloud, mTLS auth — use INSTEAD of the API key above ---
# Paths should point OUTSIDE this repository.
# TEMPORAL_ADDRESS=<namespace>.<account-id>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>.<account-id>
# TEMPORAL_TLS_CLIENT_CERT_PATH=/path/to/client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/path/to/client.key

# --- Optional ---
# TEMPORAL_TASK_QUEUE=greeting
